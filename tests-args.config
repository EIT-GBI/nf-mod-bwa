// As tests.config, plus bwa mem tuning flags passed the way a consuming
// pipeline passes them: through ext.args.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'BWA_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bwa:latest'
        cpus      = 1
    }
    withName: BWA_MEM {
        ext.args = '-k 25 -T 40'
    }
}
