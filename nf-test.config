config {
    testsDir "."
    workDir ".nf-test"
    configFile "nextflow.config"

    // Reads SAM/BAM/CRAM contents in assertions. BAM checksums are not stable
    // on their own: bwa and samtools each record their command line, and
    // samtools records -@ task.cpus, in @PG header lines.
    plugins {
        load "nft-bam@0.7.0"
    }
}
