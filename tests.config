// Config for the bwa tests that run the tool for real, rather than checking
// stub wiring.
//
// conf/module.config pins :v0.0.0, which only exists once this module is
// released, so the tests track :latest instead - the same reason the consuming
// pipeline carries a `dev` profile.
//
// The selector covers BWA_INDEX as well, which the BWA_MEM tests run in a setup
// block to produce a real index.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'BWA_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bwa:latest'
        cpus      = 1
    }
}
